# ================== 复制为 .env 并填写以下配置 ==================

# 服务端口
PORT=3000

# ---- DeepSeek 大模型（https://platform.deepseek.com 创建 Key）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云百炼（DashScope）语音识别 ASR（https://bailian.console.aliyun.com → API-KEY 管理）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 完整 base url（含地域与 WorkspaceId），由后端自己拼 /api/v1/services/... 路径。
# 注意：API Key、WorkspaceId、地域三者必须同属一个工作空间，错配会 401/403 或 model not found。
# 文档给的 workspace 化域名形如：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
ASR_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com
# 模型名以控制台「模型广场」里该 Key 实际可调用的字符串为准
ASR_MODEL=qwen-audio-3.1-asr-flash

# ---- 阿里云百炼 语音合成 TTS（朗读发音，见技术方案 6.5）----
# 与 ASR 共用上面的 DASHSCOPE_API_KEY；Qwen-Audio-TTS 目前仅华北2（北京）地域可用，
# 所以这里不能配成新加坡地域的 Key，否则 ASR 能跑、TTS 直接不可用。
# 不配 TTS_BASE_URL 时默认跟随 ASR_BASE_URL。
# TTS_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
TTS_MODEL=qwen-audio-3.1-tts-flash

# ★ 发音音色：换发音就改这一行 + 重启后端，别处都不用动。
#   voice 值区分大小写。qwen-audio-3.1-tts-flash 的精品英文音色（仅支持英文）：
#     美式女声：Abby_v3.1 / Annie_v3.1 / Ava_v3.1 / Beth_v3.1 / Betty_v3.1
#               Cally_v3.1 / Cindy_v3.1 / Donna_v3.1
#     美式男声：Andy_v3.1 / Brian_v3.1 / David_v3.1
#     英式女声：Emily_v3.1 / Luna_v3.1
#     英式男声：Eric_v3.1 / Luca_v3.1
#   先去百炼控制台 → 模型广场 → Qwen-Audio-TTS 音色列表试听，挑好再填这里。
#   注意：音色进了缓存 key，换音色后旧音频全部失效，但文件还留在盘上不命中，
#   靠下面的 TTS_CACHE_MAX_MB 慢慢清掉（也可以直接删缓存目录，更干脆）。
TTS_VOICE=Andy_v3.1

# 语速，取值 0.5~2.0。百炼是服务端变速（不变调），比前端 playbackRate 自然得多，
# 将来做「慢速跟读」直接改这里或按请求传参，不用动播放器。
TTS_RATE=1

# 音频格式，默认 mp3（体积小、iOS/Android 双端都支持），一般不用改。
TTS_FORMAT=mp3

# 目标语言提示，固定 en：让数字与符号按英文读（110 → one one zero，而不是幺幺零）。
TTS_LANGUAGE=en

# 合成结果落盘目录。缓存命中就完全不碰百炼，所以这个目录是省钱的关键：
# docker 部署时记得挂 volume，否则每次重建容器缓存清零、重新计费。
TTS_CACHE_DIR=./tts-cache

# 缓存目录体积上限（MB），默认 200；配 0 或非法值也按默认处理。
# 目录本身只增不减（换音色、场景重新生成留下的旧文件都不会再被命中），
# 所以超限时按 mtime 从旧到新删，删回上限以内。全量场景预取大约几十 MB，
# 正常用不到这个值，它只是兜住失控增长——嫌小就调大，不用改代码。
TTS_CACHE_MAX_MB=200

# ---- MongoDB（本地 docker compose 启动，端口 27018：mongodb://localhost:27018/sayhi；或 Atlas 连接串）----
MONGODB_URI=mongodb://localhost:27018/sayhi

# ---- 微信小程序（mp.weixin.qq.com 开发管理→开发设置）----
WX_APPID=wx0000000000000000
WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- JWT 密钥（随机长字符串，例如运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）----
JWT_SECRET=please-change-this-to-a-long-random-string

# ---- 应用锁访问密码的 bcrypt 哈希 ----
# 生成命令（把 你的密码 换成实际密码）：
#   node -e "require('bcryptjs').hash('你的密码',10).then(console.log)"
# （bcryptjs 会在 npm install 后可用；需在 server 目录下执行）
ACCESS_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
