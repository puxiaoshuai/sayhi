<view class="page-wrap" wx:if="{{daily}}">
  <!-- 日期导航：前后翻页看历史口语 -->
  <view class="daily-nav">
    <view class="daily-nav-btn" bindtap="onPrev">‹ 前一天</view>
    <view class="daily-nav-date">
      <text class="daily-nav-label">{{dateLabel}}</text>
      <text wx:if="{{isToday}}" class="tag tag-blue">今天</text>
    </view>
    <view class="daily-nav-btn {{canNext ? '' : 'disabled'}}" bindtap="onNext">后一天 ›</view>
  </view>

  <!-- 场景头卡：今天围绕哪个场景练 -->
  <view class="card scene-header">
    <text class="scene-emoji">{{daily.sceneEmoji}}</text>
    <view class="scene-title-wrap">
      <text class="scene-name">{{daily.sceneName}}</text>
      <text class="scene-sub">今日场景 · 10 句由浅入深</text>
    </view>
  </view>

  <!-- 10 句口语（结构沿用 scene-detail 的常用沟通语句卡片） -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">🗣️ 今日口语</text>
      <text class="header-hint">点单词单独读 · 🔊 读整句</text>
    </view>
    <view class="expr-item" wx:for="{{daily.sentences}}" wx:key="en">
      <view class="vocab-top">
        <view class="expr-row">
          <text class="sent-no">{{index + 1}}</text>
          <view class="expr-en">
            <!-- 句内单词点读（见技术方案 6.5） -->
            <block wx:for="{{item.segs}}" wx:for-item="seg" wx:for-index="innerIndex" wx:key="index">
              <text>{{seg.pre}}</text>
              <text
                wx:if="{{seg.word}}"
                class="word-tap {{seg.speaking ? 'word-speaking' : ''}}"
                catchtap="onWordTap"
                data-sent-index="{{index}}"
                data-seg-index="{{innerIndex}}"
                data-word="{{seg.word}}"
              >{{seg.word}}</text>
              <text>{{seg.post}}</text>
            </block>
          </view>
        </view>
        <view class="expr-btns">
          <text
            class="speak-btn {{item.speaking ? 'speak-btn-active' : ''}}"
            catchtap="speakSentence"
            data-index="{{index}}"
          >🔊</text>
          <text
            class="star-btn {{item.favorited ? 'active' : ''}}"
            catchtap="favSentence"
            data-index="{{index}}"
          >⭐</text>
        </view>
      </view>
      <view class="expr-zh">{{item.zh}}</view>
      <view class="expr-situ" wx:if="{{item.situation}}">💬 {{item.situation}}</view>
    </view>
  </view>
</view>

<!-- 加载中（当天口语尚未生成时，后端现场生成约需数秒） -->
<view class="loading-wrap" wx:elif="{{loading}}">
  <view class="loading-text">🗣️ 口语准备中（首次生成约需数秒）...</view>
</view>

<!-- 生成失败：给手动重试入口 -->
<view class="loading-wrap" wx:else>
  <view class="loading-text">口语生成失败，请稍后重试</view>
  <button class="daily-retry-btn" size="mini" bindtap="retry">重试</button>
</view>
