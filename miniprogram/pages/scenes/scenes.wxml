<view class="page-wrap">
  <!-- 场景页 hero -->
  <view class="scene-hero">
    <!-- 退出登录：放 hero 右上角，清门禁与登录态后回密码页（见技术方案 6.6） -->
    <button class="hero-logout" hover-class="hero-logout-hover" bindtap="logout">退出登录</button>
    <view class="hero-emoji">🎯</view>
    <view class="hero-title">场景化学习</view>
    <view class="hero-desc">逛内置场景，或输入任意场景，生成专属的词汇与常用语句</view>
  </view>

  <!-- 输入框：输入任意场景名，由大模型生成内容（已有则直接复用） -->
  <view class="gen-card">
    <input
      class="gen-input"
      value="{{inputValue}}"
      placeholder="想学什么场景？如：坐飞机 / 点咖啡"
      placeholder-class="gen-placeholder"
      confirm-type="send"
      maxlength="20"
      bindinput="onInput"
      bindconfirm="onGenerate"
    />
    <view class="gen-btn {{generating ? 'gen-btn-disabled' : ''}}" bindtap="onGenerate">
      {{generating ? '生成中…' : '生成'}}
    </view>
  </view>

  <!-- 内置场景：由后端场景树驱动，加场景前端零改动 -->
  <view class="scene-section" wx:for="{{groups}}" wx:for-item="group" wx:key="sceneKey">
    <view class="section-title">{{group.emoji}} {{group.name}}</view>
    <view class="scene-list">
      <view
        class="scene-row"
        wx:for="{{group.children}}"
        wx:for-item="scene"
        wx:key="sceneKey"
        bindtap="openScene"
        data-key="{{scene.sceneKey}}"
      >
        <text class="row-emoji">{{scene.emoji}}</text>
        <view class="row-main">
          <text class="row-name">{{scene.name}}</text>
          <text class="row-meta">物品词汇 · 常用语句</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 自定义场景：长按删除 -->
  <view class="scene-section">
    <view class="section-title">✨ 我的场景</view>
    <view class="scene-empty" wx:if="{{!customScenes.length}}">
      还没有自定义场景，在上面输入框试试「坐飞机」
    </view>
    <view class="scene-list" wx:else>
      <view
        class="scene-row"
        wx:for="{{customScenes}}"
        wx:for-item="scene"
        wx:key="sceneKey"
        bindtap="openScene"
        bindlongpress="onCustomLongPress"
        data-key="{{scene.sceneKey}}"
        data-name="{{scene.name}}"
      >
        <text class="row-emoji">{{scene.emoji}}</text>
        <view class="row-main">
          <text class="row-name">{{scene.name}}</text>
          <text class="row-meta">物品词汇 · 常用语句 · 长按删除</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 二期功能预告（见技术方案第八章） -->
  <view class="scene-locked" bindtap="comingSoon">
    <text class="locked-icon">📷</text>
    <text class="locked-text">拍照识物 · 对准物品即学英文（二期上线）</text>
  </view>
</view>
