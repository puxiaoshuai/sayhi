.lock-screen {
  position: fixed;
  inset: 0;
  background: linear-gradient(160deg, #0f172a 0%, #1e1b4b 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 32px;
}

.lock-icon {
  font-size: 48px;
}

.lock-title {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
}

.lock-desc {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}

/* 输入框外层：负责宽度、边框与聚焦态，内层 input 用 flex:1 撑满 */
.lock-field {
  width: 100%;
  max-width: 262px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 52px;
  padding: 0 16px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.08);
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}

.lock-field.is-focus {
  border-color: rgba(139, 92, 246, 0.85);
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.16);
}

.lock-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #ffffff;
  font-size: 16px;
  text-align: center;
  letter-spacing: 4px;
}

.lock-placeholder {
  color: rgba(255, 255, 255, 0.35);
  font-size: 14px;
  letter-spacing: normal;
}

.lock-btn {
  width: 100%;
  max-width: 262px;
  height: 52px;
  line-height: 52px;
  padding: 0;
  border-radius: 14px;
  background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  box-shadow: 0 6px 20px rgba(139, 92, 246, 0.35);
  transition: opacity 0.2s, transform 0.1s;
}

.lock-btn-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

.lock-btn::after {
  border: none;
}

.lock-tip {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8px;
}
