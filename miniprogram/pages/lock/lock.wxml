<!-- 密码确认页：启动第一道门，通过后 30 分钟内免输（见技术方案 6.6） -->
<view class="lock-screen">
  <view class="lock-icon">🔒</view>
  <view class="lock-title">SayHi</view>
  <view class="lock-desc">个人使用 · 请输入访问密码</view>

  <!-- input 为原生组件，在 flex 纵向容器里直接写 width:100% 会被压缩成内容宽，故外层加一层容器控制宽度 -->
  <view class="lock-field {{focused ? 'is-focus' : ''}}">
    <input
      class="lock-input"
      type="password"
      password
      placeholder="请输入访问密码"
      placeholder-class="lock-placeholder"
      value="{{password}}"
      confirm-type="done"
      bindinput="onPasswordInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      bindconfirm="onUnlock"
    />
  </view>

  <button class="lock-btn" loading="{{loading}}" hover-class="lock-btn-hover" bindtap="onUnlock">
    验证并进入
  </button>

  <view class="lock-tip">验证通过后 30 分钟内免重复输入</view>
</view>
