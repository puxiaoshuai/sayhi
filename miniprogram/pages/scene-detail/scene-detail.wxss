.scene-detail-header {
  display: flex;
  align-items: center;
  gap: 10px;
}
.detail-emoji {
  font-size: 34px;
}
.detail-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.detail-name {
  font-size: 18px;
  font-weight: 700;
  color: #0f172a;
}
.detail-sub {
  font-size: 12px;
  color: #94a3b8;
}

.vocab-clickable {
  display: inline-block;
  flex: 1;
}
.header-hint {
  font-size: 11px;
  color: #cbd5e1;
}

/* 语句 */
.expr-item {
  padding: 12px 0;
  border-bottom: 1px solid #f8fafc;
}
.expr-item:last-child {
  border-bottom: none;
}
.expr-en {
  font-weight: 600;
  color: #1e293b;
  font-size: 14px;
  line-height: 1.6;
  flex: 1;
  margin-right: 8px;
}
.word-speaking {
  background: #ede9fe;
  color: #7c3aed;
}
.expr-btns {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.speak-btn {
  font-size: 15px;
  padding: 2px 4px;
}
.expr-zh {
  font-size: 13px;
  color: #475569;
  margin-top: 4px;
}
.expr-situ {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 6px;
  background: #faf5ff;
  padding: 4px 8px;
  border-radius: 6px;
  border-left: 3px solid #8b5cf6;
  display: inline-block;
}

/* 加载态 */
.loading-wrap {
  padding-top: 40vh;
  display: flex;
  justify-content: center;
}
.loading-text {
  font-size: 13px;
  color: #94a3b8;
}
